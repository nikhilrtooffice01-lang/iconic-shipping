# --- Server ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/iconic
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters
COOKIE_SECURE=true
# APP_URL=https://your-app.onrender.com   # password reset link isi se banta hai (recommended)
# CORS_ORIGIN=https://www.yourdomain.com   # sirf agar frontend alag domain par ho

# --- Admin (npm run admin:create) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use-a-strong-password-12+chars

# --- Email: Option A (FREE Render ke liye) Brevo HTTP API ---
# Brevo > SMTP & API > API Keys > Generate. Ye set ho to SMTP ignore hota hai.
BREVO_API_KEY=
MAIL_FROM="ICONIC SHIPPING SERVICES <your-verified-sender@yourdomain.com>"
NOTIFY_EMAIL=supply@iconicshipping.org

# --- Email: Option B SMTP (sirf paid hosting / VPS / local par) ---
# Port 587 -> SMTP_SECURE=false (STARTTLS) | Port 465 -> SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# --- Company details (emails/PDF footer) ---
COMPANY_EMAIL=supply@iconicshipping.org
COMPANY_PHONE=+91 97124 76193
